# Release signing configuration (DO NOT COMMIT the real file).
#
# PREFERRED (CI / shared machines): environment variables — no secrets on
# disk at all:
#   PV_STORE_FILE      absolute path to the .jks
#   PV_STORE_PASSWORD  keystore password
#   PV_KEY_ALIAS       key alias (default: passvaultgen)
#   PV_KEY_PASSWORD    key password (default: PV_STORE_PASSWORD)
#
# FALLBACK (personal developer machines only): copy this file to
# `keystore.properties` in the project root and fill in the values.
# Keep `keystore.properties`, `*.jks`, and `*.keystore` out of version
# control (.gitignore already covers them).
#
# Generate an upload key (RSA-4096, validity 25+ years, required by Play):
#   keytool -genkeypair -v -keystore passvaultgen-upload.jks -alias passvaultgen \
#     -keyalg RSA -keysize 4096 -validity 9125
#
# Use a DIFFERENT store password and key password. If the keystore or its
# passwords ever left a trusted machine, rotate the upload key in Play
# Console (Release -> Setup -> App signing -> Key upgrade).

storeFile=../passvaultgen-upload.jks
storePassword=CHANGE_ME
keyAlias=passvaultgen
keyPassword=CHANGE_ME
