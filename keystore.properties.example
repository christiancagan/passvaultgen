# Release signing configuration (DO NOT COMMIT the real file).
#
# 1. Copy this file to `keystore.properties` in the project root.
# 2. Fill in the values for your upload keystore.
# 3. Keep `keystore.properties`, `*.jks`, and `*.keystore` out of version control.
#
# Generate an upload key (RSA-2048+, validity 25+ years, required by Play):
#   keytool -genkeypair -v -keystore passvaultgen-upload.jks -alias passvaultgen \
#     -keyalg RSA -keysize 4096 -validity 9125

storeFile=../passvaultgen-upload.jks
storePassword=CHANGE_ME
keyAlias=passvaultgen
keyPassword=CHANGE_ME
