<?xml version="1.0" encoding="utf-8"?>
<!--
  Disable all cloud backup and device-to-device transfer of app data.
  The vault is encrypted at rest, but we still prevent the encrypted
  database and any metadata from leaving the device via OS backup.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
